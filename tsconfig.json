{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"],
      "@components/*": ["components/*"],
      "@utils/*": ["utils/*"],
      "@hooks/*": ["hooks/*"],
      "@types/*": ["types/*"],
      "@services/*": ["services/*"],
      "@lib/*": ["lib/*"],
      "@pages/*": ["pages/*"],
      "@providers/*": ["providers/*"]
    }
  },
  "include": [
    "src/**/*",
    "components/**/*",
    "services/**/*",
    "hooks/**/*",
    "types/**/*",
    "utils/**/*",
    "lib/**/*",
    "pages/**/*",
    "providers/**/*",
    "app/**/*"
  ],
  "exclude": ["node_modules", "build", "dist", "coverage", "scripts"]
} 